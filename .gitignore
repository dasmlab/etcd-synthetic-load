# Build artifacts
/bin/
*.exe
*.test
*.out

# Local profile output (generated by `plan`/`make plan`) - keep the curated
# example under examples/ instead of committing every local run's output.
/profile.yaml
/*.profile.yaml

# Local kubeconfigs some people drop in-repo out of habit - never commit these.
kubeconfig
kubeconfig.*
*.kubeconfig

